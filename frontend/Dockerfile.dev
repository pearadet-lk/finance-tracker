# Dev Dockerfile — Vite dev server with HMR
FROM node:20-alpine
WORKDIR /app

# Copy package files first (layer cache)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source (will be overridden by volume mount in dev)
COPY . .

EXPOSE 5173

# Vite listens on all interfaces so Docker port mapping works
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
